{
  "name": "magic-hour-remotion",
  "version": "0.1.0",
  "description": "Magic Hour AI (lip sync, face swap, talking photo, upscaling, voice) as drop-in Remotion components.",
  "type": "module",
  "license": "MIT",
  "keywords": ["remotion", "magic-hour", "lip-sync", "face-swap", "ai-video", "react"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" },
    "./package.json": "./package.json"
  },
  "bin": { "magichour-remotion": "./bin/cli.js" },
  "files": ["dist", "bin", "skill", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "remotion": ">=4.0.0",
    "react": ">=18",
    "@remotion/studio": ">=4.0.147",
    "@remotion/bundler": ">=4.0.0",
    "@remotion/renderer": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@remotion/studio": { "optional": true },
    "@remotion/bundler": { "optional": true },
    "@remotion/renderer": { "optional": true }
  },
  "dependencies": {
    "magic-hour": "^0.92.2"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@remotion/studio": "4.0.543",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.543",
    "typescript": "^5.6.0"
  }
}
